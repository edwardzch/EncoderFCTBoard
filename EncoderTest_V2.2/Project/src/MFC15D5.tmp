            temp1 = MyTable[j][0] - MyTable[j-1][0];
            temp2 = MyTable[j][0] - temp;
            temp  = ((MyTable[j][1] - MyTable[j-1][1]) * temp2 * 10) / temp1;
            if(temp>=0){
                temp = (temp + 5) / 10;
            }  
            else{
                temp = (temp - 5) / 10;
            }  
            Table[i] = MyTable[j][1] - temp;
        }
    }  
#endif    
    
//------------------------------------------------------------------------------
//╓ў╤н╗╖  
//------------------------------------------------------------------------------
    while(1){         
#if (1) //6.5us
      if(IntSampleFlag==3){
        LED_OFF();
        Hall[1] = Hall[0];
        Hall[0] = EX_DI(1);
        if(Hall[0]==1 & Hall[1]==0){
            SMARTABS.Multi_turn++;
        }
        else if(Hall[0]==0 & Hall[1]==1){
            SMARTABS.Multi_turn--;
        }
        if(CosData[0] | SinData[0]){
            Angle[1] = Angle[0];
            Angle[0] = MyAtan2((int32_t)CosData[0], (int32_t)SinData[0]);       //calculate the new angle
            //------------------------------------------------------------------
            //index = (uint16_t)(4095-(Angle[0]>>5));                             //index is from 0 to 4095
            index = (uint16_t)((Angle[0]>>5));                                  //index is from 0 to 4095
//            temp1 = MyTable[index+1] - MyTable[index];                          //delta_Compensation(+/-)
//            temp2 = (((uint32_t)index+1)<<5) - Angle[0];                        //delta_Angle(+)
//            Compensation  = (temp1 * temp2)>>4;                                 //Compensation = delta_Compensation(+/-) * delta_Angle(+) / 32
//            if(Compensation>=0){                       //(+)
//                Compensation = (Compensation + 1)>>1;  //Compensation + 0.5
//            }  
//            else{                                      //(-)
//                Compensation = (Compensation - 1)>>1;  //Compensation - 0.5
//            }  
//            Angle[0] = (Angle[0] - Compensation) & 0x0001FFFF;
            //Angle[0] = (Angle[0] + MyTable[index]) & 0x0001FFFF;    //MyTable4096
            Angle[0] = (Angle[0] - (int16_t)MyTable[index]) & 0x0001FFFF;      //MyTable4096B
            //Angle[0] = (Angle[0] + (int16_t)MySin[index]) & 0x0001FFFF;      //MySin4096B
            //------------------------------------------------------------------
            DeltaAngle = Angle[0] - Angle[1];
            if(DeltaAngle>65535){
                DeltaAngle -= 131072;
            }  
            else if(DeltaAngle<-65535){
                DeltaAngle += 131072;
            }  
//            SpeedFilter.InValue = DeltaAngle;
//            SpeedFilter.Tf = 4;
//            SpeedFilter.Ts = 1;
//            FirstOrderFilter(&SpeedFilter);
//            NewAngle = (Angle[0] - (SpeedFilter.OutValue*2)) & 0x0001FFFF;
            SMARTABS.Absolute = Angle[0];
            //if(labs(DeltaAngle)>25){                                            //More than 100rpm
                MyCalibration();
            //}    
        }
        #ifdef RECORD
        if(record_start){
            if(record_index++<1000){
                COS_Record[record_index]   = CosData[0];
                SIN_Record[record_index]   = SinData[0];
                ANGLE_Record[record_index] = SMARTABS.Absolute;
            }  
            else{
                record_index = 0;
                record_start = 0;
            }  
        }
        #endif    
        IntSampleFlag = 0;
        LED_ON();
      }  
#endif        
    }
}

//==============================================================================
//UART0 RX Interrupt Handler
//void UART0_RX_TX_IRQHandler(void)
//==============================================================================
__ramfunc void UART0_RX_TX_IRQHandler(void)
{
    if(UART0->S1 & kUART_RxDataRegFullFlag){                                    //Read flag and auto clear flag
        PDB0->SC |= PDB_SC_SWTRIG_MASK;                                         //Software start ADC pretrigger timer
        LED_ON();
        //MyPDB0Delay();                                                          //Calculate PDB0 Delay Timer
        ABS_Encoder();                                                          //Recieve request and transfer data
    } 
}
                             
//==============================================================================
//ADC0 Active Interrupt Handler
//void ADC0_IRQHandler(void)
//==============================================================================
__ramfunc void ADC0_IRQHandler(void)
{          
    if(ADC0->SC1[0] & kADC16_ActiveFlag){
        CosData[0] = (int16_t)(ADC0->R[0]);
        IntSampleFlag |= 2;
    }
}

//==============================================================================
//ADC1 Active Interrupt Handler
//void ADC1_IRQHandler(void)
//==============================================================================
__ramfunc void ADC1_IRQHandler(void)
{
    if(ADC1->SC1[0] & kADC16_ActiveFlag){                                       //Read flag and auto clear flag
        SinData[0] = (int16_t)(ADC1->R[0]);    
        IntSampleFlag |= 1;
    }
}

//==============================================================================
//PDB0 Delay Interrupt Handler
//void PDB0_IRQHandler(void)
//==============================================================================
void PDB0_IRQHandler(void)
{
    RS485RE();
    PDB_ClearStatusFlags(PDB0, kPDB_DelayEventFlag); 
}

//==============================================================================
////Calculate PDB0 Delay Timer
//void MyPDB0Delay(void)
//==============================================================================
__ramfunc void MyPDB0Delay(void)
{
    CycleTimer[0] = FTM0->CNT;
    if(InitFlag==0){
        if(InitTimer++<1024){                                               //100us*1024=102.4ms
            CycleTime = CycleTimer[0] - CycleTimer[1];
            SumCycle += CycleTime;
        }
        else{
            AveCycle = SumCycle>>10;
            SumCycle = 0;
            InitTimer = 0;
            PDB0Time = AveCycle - (ConverTime * 48);
            if(PDB0Time>=0){
                PDB_SetADCPreTriggerDelayValue(PDB0, kPDB_ADCTriggerChannel0, kPDB_ADCPreTrigger0, PDB0Time);
                PDB_SetADCPreTriggerDelayValue(PDB0, kPDB_ADCTriggerChannel1, kPDB_ADCPreTrigger0, PDB0Time);
                PDB_DoLoadValues(PDB0);
            }
            InitFlag = 1;
        }  
    }    
    CycleTimer[1] = CycleTimer[0];
}
 
//==============================================================================
//Calculate PDB0 Delay Timer
//void MyCalibration(void)
//==============================================================================
__ramfunc void MyCalibration(void)
{
    static uint16_t i;

    if(SinData[0]>SinMax){
        SinMax = SinData[0];
    }  
    if(SinData[0]<SinMin){
        SinMin = SinData[0];
    }  
    if(CosData[0]>CosMax){
        CosMax = CosData[0];
    }  
    if(CosData[0]<CosMin){
        CosMin = CosData[0];
    }  
    if(ADCCalibrationFlag==0){
        if((Hall[0]==1 & Hall[1]==0) | (Hall[0]==0 & Hall[1]==1)){
            ADC0Offset[i] = (CosMax + CosMin)>>1;
            ADC1Offset[i] = (SinMax + SinMin)>>1;
            i++;
        }
        if(i>8){
            for(i=1; i<=8; i++){
                SumADC0Offset += ADC0Offset[i];
                SumADC1Offset += ADC1Offset[i];
            }  
            i = 0;
            ADC0OFS = SumADC0Offset>>3;
            ADC1OFS = SumADC1Offset>>3;
            SumADC0Offset = 0;
            SumADC1Offset = 0;
            ADC0->OFS = ADC0OFS;
            ADC1->OFS = ADC1OFS;
            //ADCCalibrationFlag = 1;
        }
    }
}
   
//==============================================================================
//Calculate Angle Function
//int32_t MyAtan2(int32_t x, int32_t y)
//==============================================================================
__ramfunc int32_t MyAtan2(int32_t x, int32_t y)
{
    int32_t i = 0;
    int32_t x_new, y_new;
    int32_t angleSum = 0;
    int32_t quadrant = 0;
      
    //Calculate sections
    if(x<0 && y>=0){
        x = -x;                                                                                    
        quadrant = 2; //secord section
    }
    else if(x>=0 && y<0){
        y = -y;
        quadrant = 4; //fourth section
    }
    else if(x<0 && y<0){
        x = -x;
        y = -y;
        quadrant = 3; //thrid section
    }
  
    //*1024 for more calculation accuracy
    x *= 1024; 
    y *= 1024;

    for(i=0; i<18; i++){
        if(y>=0){
            x_new = x + (y>>i);              
            y_new = y - (x>>i);
            x = x_new;
            y = y_new;
            angleSum += angleTable[i];
        }
        else{
            x_new = x - (y>>i);
            y_new = y + (x>>i);
            x = x_new;
            y = y_new;
            angleSum -= angleTable[i];
        }
    }  
      
    if(quadrant==2){
        angleSum = 0x200000 - angleSum; //180-teta
    }
    else if(quadrant==3){
        angleSum = 0x200000 + angleSum; //180+teta
    }
    else if(quadrant==4){
        angleSum = 0x400000 - angleSum; //360-teta
    }       
    angleSum = (angleSum+1)>>6;   //range = 0~65535
   
    switch(Hall[0]){
    case 0x00:     
        if(!(angleSum & 0x8000)){
            angleSum = angleSum | 0x10000;  
        }
        break;      
    case 0x01: 
        angleSum = angleSum | 0x10000;        
        break;  
    case 0x02: 
        break;         
    case 0x03:      
        if(angleSum & 0x8000){
            angleSum = angleSum | 0x10000;
        }       
        break;
    default:
        break;
    }
    
    return angleSum; //MyCompensation(angleSum);
}

#ifdef COMPENSATION
//==============================================================================
//int32_t MyCompensation(int32_t nAngle)  
//==============================================================================
__ramfunc int32_t MyCompensation(int32_t nAngle)  
{
    int32_t angleSum = nAngle;
    int32_t angleTemp = nAngle;
                                                         
    //Compensation fundamental 
    angleTemp += gnPhaseComp1stOrder;
    if(angleTemp<0){
        angleTemp += 131072;
    }
    else if(angleTemp>131071){
        angleTemp -= 131072;
    }  
    angleSum -= gnGainComp1stOrder * gaLookUpTableSin[angleTemp>>2] / 126;

    //Compensation 2nd order harmonic   
    angleTemp = nAngle<<1; 
    angleTemp += gnPhaseComp2ndOrder;
    if(angleTemp<0){
        angleTemp += 131072;
    }
    else if(angleTemp>131071){
        do{
            angleTemp -= 131072;
        }
        while(angleTemp >131071);
    }
    angleSum -= gnGainComp2ndOrder * gaLookUpTableSin[angleTemp>>2] / 126; 

    //Compensation 4th order harmonic   
    angleTemp = nAngle<<2; 
    angleTemp += gnPhaseComp4thOrder;
    if(angleTemp<0){
        angleTemp += 131072;
    }
    else if(angleTemp>131071){
        do{
            angleTemp -= 131072;
        }
        while(angleTemp >131071);
    }
    angleSum -= gnGainComp4thOrder * gaLookUpTableSin[angleTemp>>2] / 126;  

    //Compensation 8th order harmonic   
    angleTemp = nAngle<<3; 
    angleTemp += gnPhaseComp8thOrder;
    if(angleTemp<0){
        angleTemp += 131072;
    }
    else if(angleTemp>131071){
        do{
            angleTemp -= 131072;
        }
        while(angleTemp >131071);
    }
    angleSum -= gnGainComp8thOrder * gaLookUpTableSin[angleTemp>>2] / 126;    

    //Compensation 16th order harmonic   
    angleTemp = nAngle<<4; 
    angleTemp += gnPhaseComp16thOrder;
    if(angleTemp<0){
        angleTemp += 131072;
    }
    else if(angleTemp>131071){
        do{
            angleTemp -= 131072;
        }
        while(angleTemp >131071);
    }
    angleSum -= gnGainComp16thOrder * gaLookUpTableSin[angleTemp>>2] / 126;
  
    //Speed compensation
                     
    //Final cut 
    if(angleSum<0){
        angleSum += 131072;
    }
    else if(angleSum>131071){
        angleSum -= 131072;
    }             
  
    //Speed update  
    gnPreAngle[4] = gnPreAngle[3]; 
    gnPreAngle[3] = gnPreAngle[2]; 
    gnPreAngle[2] = gnPreAngle[1];   
    gnPreAngle[1] = gnPreAngle[0];   
    gnPreAngle[0] = (int32_t)angleSum; 
                   
    gnPreSpeed[1] = gnPreSpeed[0];  
    gnPreSpeed[0] = gnPreAngle[0]-gnPreAngle[1];
    
    /*
    if((gnPreSpeed[0]>=0) && (gnPreSpeed[0]<14000)){
        gnFlagOverSpeed = 0;    
        gnRotationDirection = 1;
        angleSum = (angleSum + gnPreAngle[0]) / 2;
    }
    else if((gnPreSpeed[0]>=14000) && (gnPreSpeed[0]<=117072)){
        gnFlagOverSpeed = 1;
        gnRotationDirection = 2;
    }
    else if(gnPreSpeed[0]>117072){
        gnFlagOverSpeed = 0;      
        gnRotationDirection = -1; 
        gnPreSpeed[0] -= 131072; 
        angleSum = (angleSum + gnPreAngle[0] + 131072) / 2;
    }
    else if((gnPreSpeed[0]<0) && (gnPreSpeed[0]<-14000)){
        gnFlagOverSpeed = 0;    
        gnRotationDirection = -1;
        angleSum = (angleSum + gnPreAngle[0])/2;
    }  
    else if((gnPreSpeed[0]<=-14000) && (gnPreSpeed[0]>=-117072)){
        gnFlagOverSpeed = 1;    
        gnRotationDirection = 2;
    }
    else{
        gnFlagOverSpeed = 0;    
        gnRotationDirection = 1; 
        gnPreSpeed[0] += 131072;  
        angleSum = (angleSum + gnPreAngle[0] + 131072) / 2;
    }
    */      
  
    return angleSum;  
}
#endif


